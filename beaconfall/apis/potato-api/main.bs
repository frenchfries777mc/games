mod "Potato API"

publish_aliases:
    aliases_name: "%player_location%"
    use_command:
        set variable {_got_} to ""
        signal send "%player_location%" to mod "potato api"
        every 1 second:
            if signal receive "%player_location%" into {_got_} run text replace "%player_location%" to {_got_}

    aliases_name: "%player_x%"
    use_command:
