on signal "%player_location%":
    set variable {_v_} to "%player_x% %player_z%"
    signal send "%player_location%" {_v_} to mod back

on signal "%player_dimension%":
    set variable {_v_} to "overworld"
    if player dimension is deep_void:
        set variable {_v_} to "deep_void"
    signal send "%player_dimension%" {_v_} to mod back

on signal "%player_x%":
    set variable {_v_} to 0
    set variable {_t_} to 1000
    loop 27 times:
        if player x >= variable {_t_}:
            add 1000 to variable {_v_}
        add 1000 to variable {_t_}
    set variable {_t_} to variable {_v_}
    add 100 to variable {_t_}
    loop 9 times:
        if player x >= variable {_t_}:
            add 100 to variable {_v_}
        add 100 to variable {_t_}
    set variable {_t_} to variable {_v_}
    add 10 to variable {_t_}
    loop 9 times:
        if player x >= variable {_t_}:
            add 10 to variable {_v_}
        add 10 to variable {_t_}
    set variable {_t_} to variable {_v_}
    add 1 to variable {_t_}
    loop 9 times:
        if player x >= variable {_t_}:
            add 1 to variable {_v_}
        add 1 to variable {_t_}
    signal send "%player_x%" {_v_} to mod back

on signal "%player_z%":
    set variable {_v_} to 0
    set variable {_t_} to 1000
    loop 27 times:
        if player z >= variable {_t_}:
            add 1000 to variable {_v_}
        add 1000 to variable {_t_}
    set variable {_t_} to variable {_v_}
    add 100 to variable {_t_}
    loop 9 times:
        if player z >= variable {_t_}:
            add 100 to variable {_v_}
        add 100 to variable {_t_}
    set variable {_t_} to variable {_v_}
    add 10 to variable {_t_}
    loop 9 times:
        if player z >= variable {_t_}:
            add 10 to variable {_v_}
        add 10 to variable {_t_}
    set variable {_t_} to variable {_v_}
    add 1 to variable {_t_}
    loop 9 times:
        if player z >= variable {_t_}:
            add 1 to variable {_v_}
        add 1 to variable {_t_}
    signal send "%player_z%" {_v_} to mod back

on signal "%player_y%":
    set variable {_v_} to ""
    set variable {_f_} to 0
    loop 30 times:
        add 1 to variable {_f_}
        set variable {_g_} to variable {_f_}
        divide variable {_g_} by 10
        if player y = variable {_g_}:
            set variable {_v_} to variable {_g_}
    signal send "%player_y%" {_v_} to mod back

on signal "%player_hp%":
    set variable {_v_} to ""
    set variable {_f_} to 0
    loop 1000 times:
        add 1 to variable {_f_}
        set variable {_g_} to variable {_f_}
        divide variable {_g_} by 10
        if player hp = variable {_g_}:
            set variable {_v_} to variable {_g_}
    signal send "%player_hp%" {_v_} to mod back

on signal "%player_max_hp%":
    set variable {_v_} to ""
    set variable {_f_} to 0
    loop 1000 times:
        add 1 to variable {_f_}
        set variable {_g_} to variable {_f_}
        divide variable {_g_} by 10
        if player max hp = variable {_g_}:
            set variable {_v_} to variable {_g_}
    signal send "%player_max_hp%" {_v_} to mod back

on signal "%world_day%":
    set variable {_v_} to ""
    set variable {_f_} to 0
    loop 1000 times:
        if world day = variable {_f_}:
            set variable {_v_} to variable {_f_}
        add 1 to variable {_f_}
    signal send "%world_day%" {_v_} to mod back

on signal "%world_time%":
    set variable {_v_} to ""
    set variable {_f_} to 0
    loop 24 times:
        if world hour = variable {_f_}:
            set variable {_v_} to variable {_f_}
        add 1 to variable {_f_}
    signal send "%world_time%" {_v_} to mod back

on signal "%world_player_count%":
    set variable {_v_} to ""
    set variable {_f_} to 0
    loop 16 times:
        if world players = variable {_f_}:
            set variable {_v_} to variable {_f_}
        add 1 to variable {_f_}
    signal send "%world_player_count%" {_v_} to mod back

on signal "%player_biome%":
    set variable {_v_} to ""
    if player biome is start:
        set variable {_v_} to "시작섬"
    if player biome is forest:
        set variable {_v_} to "숲섬"
    if player biome is desert:
        set variable {_v_} to "사막섬"
    if player biome is volcano:
        set variable {_v_} to "화산섬"
    if player biome is jungle:
        set variable {_v_} to "정글섬"
    if player biome is mesa:
        set variable {_v_} to "메사섬"
    if player biome is rock:
        set variable {_v_} to "돌섬"
    if player biome is mangrove:
        set variable {_v_} to "맹그로브섬"
    if player biome is ice:
        set variable {_v_} to "얼음섬"
    signal send "%player_biome%" {_v_} to mod back

on signal "%random%":
    set variable {_v_} to ""
    set variable {_v_} to random 1 to 100
    signal send "%random%" {_v_} to mod back

on signal "%eaten_item%":
    set variable {_v_} to variable {eaten_item}
    signal send "%eaten_item%" {_v_} to mod back

on signal "%eaten%":
    set variable {_v_} to variable {eaten_item}
    signal send "%eaten%" {_v_} to mod back

on signal "%interacted%":
